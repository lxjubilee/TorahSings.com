# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Testing
/coverage

# Next.js
/.next/
# Alternate build dirs from NEXT_DIST_DIR (see next.config.mjs) — used to get
# past a wedged Turbopack cache on the SMB drive.
/.next-*/
/out/
/build
next-env.d.ts

# Production
/dist

# Misc
.DS_Store
*.pem
Thumbs.db

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local env files
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# Vercel
.vercel

# TypeScript
*.tsbuildinfo

# IDE / editor
.idea/
*.swp

# Local dev auth database (scripts/local-auth-server.mjs) — never commit accounts.
.local-auth.db
.local-auth.db-*

# Personal Claude Code overrides — grants SSH/deploy access; never commit.
.claude/settings.local.json

# ArticleImageStudio (.NET/WPF tool under tools/) — build output, VS files, and
# its local runtime state. (tools/ArticleImageStudio/.gitignore also covers
# bin/obj/.webview2; these belt-and-suspenders entries catch the rest.)
tools/**/bin/
tools/**/obj/
tools/**/.vs/
tools/**/.webview2/
tools/**/*.user
tools/**/studio.config.json
tools/**/cookies.json
